<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CaloriesTracking.Application\CaloriesTracking.Application.csproj" />
    <ProjectReference Include="..\CaloriesTracking.Domain\CaloriesTracking.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy seed CSV cạnh binary để chạy được trong Docker -->
    <None Include="Data\SeedData\usda_calorie_dataset.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="SeedData\usda_calorie_dataset.csv" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exposes the seeder's AfterBatchCommitted test seam so interruption and
         resume can be triggered at an exact checkpoint instead of by sleeping. -->
    <InternalsVisibleTo Include="CaloriesTracking.Api.Tests" />
    <InternalsVisibleTo Include="CaloriesTracking.Postgres.Tests" />
  </ItemGroup>

</Project>
